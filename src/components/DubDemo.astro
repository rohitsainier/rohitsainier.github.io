---
import { url } from '../data/site';
---

<dialog class="demo" data-demo aria-labelledby="demo-title">
  <div class="demo__curtain" data-demo-curtain aria-hidden="true"></div>
  <div class="demo__inner" data-demo-inner>
    <header class="demo__head">
      <p id="demo-title" class="micro"><span class="rec" aria-hidden="true"></span>AI video → video <span class="dim">· English → हिन्दी</span></p>
      <p class="micro demo__hint">Click a side to listen <span class="dim">· ← → switch · space play</span></p>
      <button class="demo__close" type="button" data-demo-close aria-label="Close demonstration" data-magnetic><span aria-hidden="true">×</span></button>
    </header>

    <div class="demo__stage" role="group" aria-label="Side-by-side comparison">
      {[
        { l: 'en', label: 'Original', lang: 'English', sub: 'Source recording' },
        { l: 'hi', label: 'AI dub', lang: 'हिन्दी', sub: 'Cloned voice · regenerated lips' },
      ].map((p) => (
        <button class={`demo__panel demo__panel--${p.l}`} type="button" data-panel={p.l} aria-pressed={p.l === 'hi' ? 'true' : 'false'}>
          <span class="demo__vwrap">
            <video data-dv={p.l} playsinline preload="auto" poster={url('media/hero/poster.webp')}>
              <source src={url(`media/hero/${p.l}.webm`)} type="video/webm" />
              <source src={url(`media/hero/${p.l}.mp4`)} type="video/mp4" />
              <track kind="captions" srclang={p.l} label={p.lang} src={url(`media/hero/${p.l}.vtt`)} />
            </video>
            <span class="demo__cap" data-dcap={p.l} lang={p.l} aria-hidden="true"></span>
            <span class="demo__listen micro" aria-hidden="true"><i></i><i></i><i></i> Listening</span>
          </span>
          <span class="demo__meta">
            <span class="micro">{p.label}</span>
            <span class="demo__lang" lang={p.l}>{p.lang}</span>
            <span class="micro dim">{p.sub}</span>
          </span>
        </button>
      ))}
    </div>

    <footer class="demo__bar">
      <button class="demo__play micro" type="button" data-demo-play aria-label="Pause">
        <span class="demo__pp" aria-hidden="true"></span><span data-demo-play-label>Pause</span>
      </button>
      <div class="demo__progress" aria-hidden="true"><i data-demo-progress></i></div>
      <p class="micro dim demo__time" data-demo-time>00:00 / 00:24</p>
      <div class="demo__seg" role="group" aria-label="Audio language">
        <button type="button" class="micro" data-seg="en" aria-pressed="false">EN</button>
        <button type="button" data-seg="hi" lang="hi" aria-pressed="true">हिन्दी</button>
      </div>
      <button class="demo__restart micro" type="button" data-demo-restart>Restart</button>
    </footer>
  </div>
</dialog>

<style>
  .demo {
    position: fixed; inset: 0; z-index: 300;
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: transparent; color: var(--fg);
    overflow: hidden;
  }
  .demo::backdrop { background: transparent; }
  .demo__curtain { position: absolute; inset: 0; background: #050505; clip-path: circle(0% at var(--ox, 50%) var(--oy, 50%)); }
  .demo[open] .demo__curtain { clip-path: circle(150% at var(--ox, 50%) var(--oy, 50%)); }
  .demo__inner {
    position: relative; height: 100%;
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
    padding: 18px var(--pad) calc(18px + env(safe-area-inset-bottom));
  }
  .demo__head { display: flex; align-items: center; gap: 20px; }
  .demo__head .micro:first-child { display: flex; align-items: center; gap: 10px; color: var(--fg); margin-right: auto; }
  .demo__hint { color: var(--fg-2); }
  .demo__close {
    width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid var(--line-2);
    font-size: 1.6rem; line-height: 1;
    display: grid; place-items: center;
    transition: background 0.3s, color 0.3s;
  }
  .demo__close:hover { background: var(--fg); color: var(--bg); }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }

  .demo__stage {
    min-height: 0;
    display: flex; justify-content: center; align-items: center;
    gap: clamp(14px, 2.4vw, 40px);
    padding-block: 2vh;
  }
  .demo__panel {
    height: 100%; min-height: 0;
    display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
    text-align: left;
    opacity: 0.55;
    transition: opacity 0.6s var(--ease-out);
  }
  .demo__panel[aria-pressed='true'] { opacity: 1; }
  .demo__panel:hover { opacity: 0.9; }
  .demo__vwrap {
    position: relative; flex: none;
    height: calc(100% - 76px); width: auto;
    aspect-ratio: 732 / 1280;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-2);
    transition: box-shadow 0.5s;
  }
  .demo__panel[aria-pressed='true'] .demo__vwrap { box-shadow: 0 0 0 2px var(--accent), 0 30px 90px -30px rgb(255 91 34 / 0.35); }
  .demo__vwrap video { width: 100%; height: 100%; object-fit: cover; }
  .demo__cap {
    position: absolute; left: 6%; right: 6%; bottom: 6%;
    text-align: center; color: #fff;
    font: 500 clamp(0.85rem, 1.25vw, 1.15rem)/1.4 var(--sans);
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.95), 0 0 2px #000;
  }
  .demo__cap:lang(hi) { font-family: var(--deva-sans); line-height: 1.55; }
  .demo__listen {
    position: absolute; left: 14px; top: 14px;
    display: none; align-items: center; gap: 3px;
    padding: 6px 9px; border-radius: 6px;
    background: var(--accent); color: var(--accent-ink); font-size: 0.625rem;
  }
  .demo__listen i { width: 2px; height: 10px; background: currentColor; animation: eq 0.9s ease-in-out infinite; }
  .demo__listen i:nth-child(2) { animation-delay: -0.3s; }
  .demo__listen i:nth-child(3) { animation-delay: -0.6s; margin-right: 5px; }
  @keyframes eq { 50% { transform: scaleY(0.3); } }
  .demo__panel[aria-pressed='true'] .demo__listen { display: inline-flex; }
  .demo__meta { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: baseline; }
  .demo__meta .micro:first-child { color: var(--accent); }
  .demo__lang { font-size: clamp(1.4rem, 2.2vw, 2rem); letter-spacing: -0.03em; line-height: 1; }
  .demo__lang:lang(hi) { font-family: var(--deva); letter-spacing: 0; }
  .demo__meta .micro:last-child { grid-column: 1 / -1; margin-top: 6px; }

  .demo__bar { display: flex; align-items: center; gap: 18px; padding-top: 12px; border-top: 1px solid var(--line); }
  .demo__play, .demo__restart { display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 14px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--fg); }
  .demo__pp { width: 10px; height: 10px; background: linear-gradient(90deg, currentColor 0 35%, transparent 35% 65%, currentColor 65%); }
  .demo__play.is-paused .demo__pp { background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .demo__progress { flex: 1; height: 2px; background: var(--line-2); border-radius: 2px; overflow: hidden; }
  .demo__progress i { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  .demo__time { font-variant-numeric: tabular-nums; }
  .demo__seg { display: inline-flex; padding: 3px; border: 1px solid var(--line-2); border-radius: 999px; }
  .demo__seg button { height: 30px; padding: 0 14px; border-radius: 999px; color: var(--fg-2); transition: background 0.3s, color 0.3s; }
  .demo__seg button[lang='hi'] { font-family: var(--deva-sans); font-size: 0.8rem; }
  .demo__seg button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }

  @media (max-width: 859px) {
    .demo__hint { display: none; }
    .demo__stage { position: relative; }
    .demo__panel { position: absolute; inset: 2vh 0; align-items: center; opacity: 0; pointer-events: none; }
    .demo__panel[aria-pressed='true'] { opacity: 1; pointer-events: auto; }
    .demo__vwrap { height: calc(100% - 90px); }
    .demo__meta { width: 100%; }
    .demo__bar { flex-wrap: wrap; }
    .demo__progress { order: -1; flex-basis: 100%; }
  }
</style>
