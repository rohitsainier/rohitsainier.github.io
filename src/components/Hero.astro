---
import { url } from '../data/site';
import en from '../data/hero-en.json';

const pipeline = [
  { name: 'Video', detail: 'Source · 732×1280 · 25 fps' },
  { name: 'Speech recognition', detail: `word-level timing · ${en.words.length} words` },
  { name: 'Translation', detail: 'en → hi · timing-aware' },
  { name: 'Voice generation', detail: 'cloned from the source voice' },
  { name: 'Lip synchronization', detail: 'mouth region · frame by frame' },
  { name: 'Video', detail: 'loudness-matched · muxed' },
];

const beats = [
  { no: 'Source', title: 'The original video.', body: 'One take, one speaker, English. Everything that follows is generated from these 23 seconds.' },
  { no: 'Audio', title: 'Isolate the voice.', body: 'The soundtrack becomes a waveform the models can reason about.' },
  { no: 'Transcript', title: 'Every word, timestamped.', body: `Speech recognition catches every word — ${en.words.length} of them, each pinned to the millisecond.` },
  { no: 'Language', title: 'Detect the language.', body: `English, with ${(en.probability * 100).toFixed(1)}% confidence. Now pick a new one.` },
  { no: 'Translation', title: 'Rewrite it in Hindi.', body: 'Each sentence is translated to fit the time the original took to say it.' },
  { no: 'Voice', title: 'Speak it in the same voice.', body: 'A voice model clones the speaker from a few seconds of audio and reads the translation.' },
  { no: 'Lip sync', title: 'Move the lips to match.', body: 'Only the lower half of the face is regenerated, frame by frame, to match the new audio.' },
  { no: 'Output', title: 'Same face. New language.', body: 'Nothing re-shot. Nothing re-recorded. The person never said these words — their face does.' },
  { no: 'Pipeline', title: 'Five models. One timeline.', body: 'Video → speech → translation → voice → lips → video. Time stays aligned from the first word to the last frame.' },
];
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__copy">
      <div class="hero__intro" data-hero-intro>
        <p class="hero__eyebrow micro"><span class="rec" aria-hidden="true"></span>AI video experiment — 001</p>
        <h1 id="hero-title" class="hero__title" data-hero-title>
          <span class="hl"><span>One video.</span></span>
          <span class="hl"><span>Any language.</span></span>
          <span class="hl"><span class="serif">Same face.</span></span>
        </h1>
        <p class="hero__lede" data-hero-fade>
          An experimental AI video-to-video pipeline that translates speech, generates a new voice and synchronizes the
          speaker’s lips to the translated dialogue.
        </p>
        <div class="hero__ctas" data-hero-fade>
          <button class="btn btn--solid" type="button" data-demo-open data-cursor="play" data-magnetic>
            Watch the transformation <span class="arrow" aria-hidden="true">→</span>
          </button>
          <a class="hero__case micro link-u" href={url('work/ai-video-dubbing')} data-cursor="view">Read the case study</a>
        </div>
      </div>

      <ol class="hero__beats" data-beats>
        {beats.map((b, i) => (
          <li class="beat" data-beat={i + 1}>
            <p class="beat__no micro"><span class="accent">{String(i + 1).padStart(2, '0')}</span> — {b.no}</p>
            <h2 class="beat__title">{b.title}</h2>
            <p class="beat__body">{b.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <figure class="hero__video" data-hero-video>
      <div class="hv__frame" data-frame>
        <div class="hv__zoom" data-zoom>
          <video
            class="hv__v hv__v--src"
            data-v="en"
            muted
            playsinline
            loop
            preload="auto"
            poster={url('media/hero/poster.webp')}
            aria-label="The original clip: an AI presenter with Rohit's face speaks English"
          >
            <source src={url('media/hero/en.webm')} type="video/webm" />
            <source src={url('media/hero/en.mp4')} type="video/mp4" />
            <track kind="captions" srclang="en" label="English" src={url('media/hero/en.vtt')} />
          </video>
          <video
            class="hv__v hv__v--dub"
            data-v="hi"
            muted
            playsinline
            loop
            preload="auto"
            poster={url('media/hero/poster.webp')}
            aria-label="The same clip dubbed into Hindi, with the lips regenerated to match"
          >
            <source src={url('media/hero/hi.webm')} type="video/webm" />
            <source src={url('media/hero/hi.mp4')} type="video/mp4" />
            <track kind="captions" srclang="hi" label="हिन्दी" src={url('media/hero/hi.vtt')} />
          </video>
          <div class="hv__roi" data-roi aria-hidden="true">
            <span class="hv__roi-label">face · mouth region</span>
            <span class="hv__roi-mask"><em>regenerated</em></span>
          </div>
        </div>
        <div class="hv__hud" aria-hidden="true">
          <span class="hv__corner hv__corner--tl"></span><span class="hv__corner hv__corner--tr"></span>
          <span class="hv__corner hv__corner--bl"></span><span class="hv__corner hv__corner--br"></span>
          <p class="hv__tag micro" data-tag><span class="rec"></span><span data-tag-text>Source · English</span></p>
          <p class="hv__tc micro" data-tc>00:00:00</p>
          <p class="hv__caption" data-caption></p>
          <span class="hv__scan" data-scan></span>
        </div>
        <button class="hv__toggle micro" type="button" data-lang-toggle aria-pressed="false">
          <span data-l="en">EN</span><i aria-hidden="true"></i><span data-l="hi">हिन्दी</span>
          <span class="sr-only">Switch between the English source and the Hindi dub</span>
        </button>
      </div>
      <figcaption class="sr-only">
        A 23-second clip of Rohit’s AI presenter speaking English, and the same clip dubbed into Hindi with a cloned
        voice and regenerated lip movement.
      </figcaption>
    </figure>

    <aside class="hero__console" aria-label="Pipeline console" data-console>
      <div class="mod mod--wave" data-mod="wave">
        <header class="mod__head">
          <span class="micro">Audio</span>
          <span class="micro mod__meta" data-wave-label>EN · source voice</span>
        </header>
        <canvas class="wave" data-wave aria-hidden="true"></canvas>
      </div>

      <div class="mod mod--text" data-mod="text">
        <header class="mod__head">
          <span class="micro">Transcript</span>
          <span class="lang" data-lang>
            <span class="lang__code">EN</span>
            <span class="lang__bar"><i style={`--p:${en.probability}`}></i></span>
            <span class="lang__p">{(en.probability * 100).toFixed(1)}%</span>
          </span>
        </header>
        <p class="tx tx--en" data-tx-en></p>
        <p class="tx tx--hi" lang="hi" data-tx-hi></p>
      </div>

      <div class="mod mod--pipe" data-mod="pipe">
        <header class="mod__head">
          <span class="micro">Pipeline</span>
          <span class="micro mod__meta"><span data-pipe-count>0</span> / 6 stages</span>
        </header>
        <ol class="pipe">
          {pipeline.map((p, i) => (
            <li class="pipe__row" data-stage={i}>
              <span class="pipe__st" aria-hidden="true"></span>
              <span class="pipe__name">{p.name}</span>
              <span class="pipe__detail">{p.detail}</span>
            </li>
          ))}
        </ol>
      </div>
    </aside>

    <div class="hero__foot">
      <p class="micro hero__sig">Rohit Saini <span aria-hidden="true">—</span> AI Engineer / Creator / Builder</p>
      <p class="micro hero__cue" data-cue><i aria-hidden="true"></i>Scroll to run the pipeline</p>
      <div class="hero__ticks" data-ticks role="group" aria-label="Jump to pipeline step">
        {beats.map((b, i) => (
          <button type="button" class="tick" data-tick={i + 1} aria-label={`Step ${i + 1}: ${b.no}`}><i></i></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; }
  .hero__stage {
    position: relative;
    height: 100svh; min-height: 680px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) auto minmax(0, 0.95fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: clamp(24px, 3.4vw, 64px);
    padding: calc(var(--nav-h) + 2.5svh) var(--pad) 20px;
    max-width: var(--max); margin-inline: auto;
  }

  /* ——— left: title + beats ——— */
  .hero__copy { grid-column: 1; grid-row: 1; align-self: center; position: relative; min-height: 60%; display: grid; align-items: center; container-type: inline-size; }
  .hero__intro, .hero__beats { grid-area: 1 / 1; }
  .hero__eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: clamp(18px, 3svh, 30px); color: var(--fg); }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: blink 1.6s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .hero__title {
    font-size: clamp(2.6rem, 16.2cqi, 7.2rem);
    line-height: 0.9; letter-spacing: -0.055em; font-weight: 500;
  }
  .hl { display: block; overflow: clip; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hl > span { display: inline-block; white-space: nowrap; }
  .hero__title .serif { color: var(--accent); font-size: 1.1em; letter-spacing: -0.035em; line-height: 0.8; padding-right: 0.06em; }
  .hero__lede { margin-top: clamp(20px, 3.4svh, 34px); max-width: 40ch; color: var(--fg-2); font-size: clamp(0.98rem, 0.9rem + 0.3vw, 1.12rem); }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: clamp(22px, 4svh, 40px); }
  .hero__case { color: var(--fg-2); padding: 6px 0; }
  .hero__case:hover { color: var(--fg); }

  .hero__beats { position: relative; align-self: center; pointer-events: none; }
  .beat { grid-area: 1 / 1; }
  .hero__beats { display: grid; }
  .beat { max-width: 30ch; }
  .beat__no { margin-bottom: 18px; }
  .beat__title { font-size: clamp(2rem, 3.6vw, 3.9rem); line-height: 0.98; letter-spacing: -0.045em; }
  .beat__body { margin-top: 18px; color: var(--fg-2); max-width: 36ch; }
  html.motion .beat { opacity: 0; visibility: hidden; }

  /* ——— center: video ——— */
  .hero__video {
    grid-column: 2; grid-row: 1; align-self: center;
    height: min(76svh, 820px);
    aspect-ratio: 732 / 1280;
    position: relative;
  }
  .hv__frame {
    position: absolute; inset: 0;
    border-radius: 18px; overflow: hidden;
    background: #050505;
    box-shadow: 0 0 0 1px var(--line), 0 40px 120px -40px rgb(0 0 0 / 0.9);
    isolation: isolate;
  }
  .hv__zoom { position: absolute; inset: 0; transform-origin: 52% 38.7%; }
  .hv__v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv__v--src { filter: saturate(0.82) contrast(1.02); }
  .hv__v--dub { clip-path: circle(0% at 52% 38.7%); }
  .hv__roi {
    position: absolute; left: 40.5%; top: 28.6%; width: 23%; height: 16%;
    border: 1px solid var(--accent);
    opacity: 0; pointer-events: none;
  }
  .hv__roi-label {
    position: absolute; left: -1px; bottom: 100%; margin-bottom: 3px;
    padding: 2px 4px; background: var(--accent); color: var(--accent-ink);
    font: 600 5px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
  }
  .hv__roi-mask {
    position: absolute; left: 0; right: 0; bottom: 0; height: 50%;
    background: repeating-linear-gradient(135deg, rgb(255 91 34 / 0.35) 0 1px, transparent 1px 4px);
    border-top: 1px dashed var(--accent);
  }
  .hv__roi-mask em {
    position: absolute; right: 2px; bottom: 2px;
    font: 600 4px/1 var(--mono); font-style: normal; letter-spacing: 0.1em; text-transform: uppercase; color: #fff;
  }

  .hv__hud { position: absolute; inset: 0; pointer-events: none; }
  .hv__corner { position: absolute; width: 18px; height: 18px; border: 1.5px solid rgb(255 255 255 / 0.75); }
  .hv__corner--tl { left: 14px; top: 14px; border-right: 0; border-bottom: 0; }
  .hv__corner--tr { right: 14px; top: 14px; border-left: 0; border-bottom: 0; }
  .hv__corner--bl { left: 14px; bottom: 14px; border-right: 0; border-top: 0; }
  .hv__corner--br { right: 14px; bottom: 14px; border-left: 0; border-top: 0; }
  .hv__tag {
    position: absolute; left: 22px; top: 22px;
    display: flex; align-items: center; gap: 8px;
    padding: 7px 10px; border-radius: 6px;
    background: rgb(0 0 0 / 0.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: #fff; font-size: 0.625rem;
  }
  .hv__tag.is-dub { background: var(--accent); color: var(--accent-ink); }
  .hv__tag.is-dub .rec { background: var(--accent-ink); box-shadow: none; }
  .hv__tc { position: absolute; right: 24px; top: 28px; color: rgb(255 255 255 / 0.85); font-size: 0.625rem; font-variant-numeric: tabular-nums; }
  .hv__caption {
    position: absolute; left: 50%; bottom: 7%;
    width: 84%; transform: translateX(-50%);
    text-align: center; color: #fff;
    font: 500 clamp(0.78rem, 0.95vw, 0.95rem)/1.35 var(--sans);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.9), 0 0 2px rgb(0 0 0 / 0.8);
    min-height: 2.7em;
  }
  .hv__caption:lang(hi), .hv__caption.is-hi { font-family: var(--deva-sans); line-height: 1.5; }
  .hv__caption b { font-weight: 600; color: var(--accent-2); }
  .hv__scan {
    position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 24px 4px rgb(255 91 34 / 0.55);
    opacity: 0;
  }
  .hv__toggle {
    position: absolute; right: 16px; bottom: 16px; z-index: 3;
    display: none; align-items: center; gap: 8px;
    height: 34px; padding: 0 12px; border-radius: 999px;
    background: rgb(0 0 0 / 0.6); color: #fff;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .hv__toggle i { width: 26px; height: 14px; border-radius: 99px; background: rgb(255 255 255 / 0.25); position: relative; }
  .hv__toggle i::after { content: ''; position: absolute; left: 2px; top: 2px; width: 10px; height: 10px; border-radius: 50%; background: #fff; transition: transform 0.4s var(--ease-out); }
  .hv__toggle[aria-pressed='true'] i { background: var(--accent); }
  .hv__toggle[aria-pressed='true'] i::after { transform: translateX(12px); }
  .hv__toggle [data-l='hi'] { font-family: var(--deva-sans); letter-spacing: 0; text-transform: none; font-size: 0.75rem; }

  /* ——— right: console ——— */
  .hero__console {
    grid-column: 3; grid-row: 1; align-self: center;
    display: grid; gap: 12px;
    font-size: 0.8125rem;
  }
  .mod {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.025), rgb(255 255 255 / 0.008));
    padding: 12px 14px 14px;
  }
  .mod__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .mod__head .micro { font-size: 0.625rem; }
  .mod__meta { color: var(--fg-3); }
  .wave { width: 100%; height: 64px; }

  .lang { display: inline-flex; align-items: center; gap: 8px; font: 500 0.625rem/1 var(--mono); letter-spacing: 0.08em; color: var(--fg-2); }
  .lang__code { color: var(--fg); padding: 3px 5px; border: 1px solid var(--line-2); border-radius: 4px; }
  .lang__bar { width: 44px; height: 3px; background: var(--line-2); border-radius: 2px; overflow: hidden; }
  .lang__bar i { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--accent); transform-origin: 0 50%; }
  .tx { min-height: 3.1em; line-height: 1.5; color: var(--fg-3); }
  .tx--en { font-size: 0.875rem; }
  .tx--en :global(.w) { transition: color 0.2s; }
  .tx--en :global(.w.is-on) { color: var(--fg); }
  .tx--en :global(.w.is-past) { color: var(--fg-2); }
  .tx--hi {
    margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--line-2);
    font-family: var(--deva); font-size: 1.02rem; line-height: 1.55; color: var(--fg);
  }
  html.motion .tx--hi { opacity: 0; }

  .pipe { display: grid; }
  .pipe__row {
    display: grid; grid-template-columns: 16px 1fr; align-items: center; column-gap: 10px; row-gap: 3px;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    color: var(--fg-3);
    transition: color 0.5s;
  }
  .pipe__row:first-child { border-top: 0; }
  .pipe__name { color: inherit; font-size: 0.8125rem; }
  .pipe__detail { grid-column: 2; font: 450 0.625rem/1.2 var(--mono); letter-spacing: 0.04em; color: var(--fg-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (min-width: 1500px) {
    .pipe__row { grid-template-columns: 16px 1fr auto; }
    .pipe__detail { grid-column: auto; text-align: right; }
  }
  @media (max-height: 920px) and (max-width: 1499px) {
    .pipe__row { padding: 5px 0; }
    .pipe__detail { display: none; }
    .pipe__row.is-run .pipe__detail { display: block; }
    .wave { height: 52px; }
    .mod { padding: 10px 12px 12px; }
  }
  .pipe__st { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--line-3); transition: all 0.4s; }
  .pipe__row.is-run { color: var(--fg); }
  .pipe__row.is-run .pipe__st { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 0 4px rgb(255 91 34 / 0.2); animation: pulse 1.6s infinite; }
  .pipe__row.is-done { color: var(--fg-2); }
  .pipe__row.is-done .pipe__st { border-color: var(--fg-2); background: var(--fg-2); }
  .pipe__row.is-done .pipe__detail, .pipe__row.is-run .pipe__detail { color: var(--fg-2); }

  /* ——— bottom bar ——— */
  .hero__foot {
    grid-column: 1 / -1; grid-row: 2;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px;
    padding-top: 14px; border-top: 1px solid var(--line);
  }
  .hero__sig { color: var(--fg-2); }
  .hero__cue { display: flex; align-items: center; gap: 12px; color: var(--fg-2); }
  .hero__cue i { position: relative; width: 1px; height: 22px; background: var(--line-2); overflow: hidden; }
  .hero__cue i::after { content: ''; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--accent); animation: cue 1.8s var(--ease-io) infinite; }
  @keyframes cue { to { top: 100%; } }
  .hero__ticks { display: flex; justify-content: flex-end; gap: 4px; }
  .tick { width: 22px; height: 22px; display: grid; place-items: center; }
  .tick i { width: 14px; height: 2px; border-radius: 2px; background: var(--line-2); transition: background 0.4s, width 0.4s var(--ease-out); }
  .tick.is-on i { background: var(--accent); width: 20px; }
  .tick.is-done i { background: var(--fg-3); }

  /* ——— reduced motion & no-JS: static, complete layout ——— */
  html:not(.motion) .hero__ticks, html:not(.motion) .hero__cue { visibility: hidden; }
  html:not(.motion) .hero__beats { display: none; }
  html:not(.motion) .hv__toggle { display: inline-flex; }

  /* ——— tablet ——— */
  @media (max-width: 1180px) {
    .hero__stage { grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto minmax(0, 1fr) auto; row-gap: 18px; }
    .hero__copy { grid-column: 1; grid-row: 1 / 3; }
    .hero__video { grid-column: 2; grid-row: 1 / 3; height: min(72svh, 760px); }
    .hero__console { display: none; }
    .hero__foot { grid-row: 3; }
  }

  /* ——— mobile: vertical, no pinning ——— */
  @media (max-width: 859px) {
    .hero__stage {
      height: auto; min-height: 0;
      display: flex; flex-direction: column;
      padding-top: calc(var(--nav-h) + 22px); padding-bottom: 28px;
    }
    .hero__copy { min-height: 0; display: block; align-self: stretch; width: 100%; }
    .hero__beats { display: none; }
    .hero__title { font-size: clamp(2.9rem, 15.5cqi, 4.8rem); }
    .hero__lede { font-size: 1rem; }
    .hero__video { order: 3; width: 100%; height: auto; margin-top: 30px; align-self: stretch; }
    .hv__frame { position: relative; aspect-ratio: 732 / 1280; max-height: 82svh; margin-inline: auto; }
    .hv__toggle { display: inline-flex; }
    .hv__caption { font-size: 0.9rem; }
    .hero__console { order: 4; display: grid; margin-top: 16px; align-self: stretch; }
    .mod--wave { display: none; }
    .hero__foot { order: 5; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 24px; }
    .hero__cue, .hero__ticks { display: none; }
    html.motion .tx--hi { opacity: 1; }
  }
</style>
