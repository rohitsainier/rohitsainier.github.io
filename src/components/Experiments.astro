---
import { experiments, areas } from '../data/lab';
import { url } from '../data/site';
const rows = [experiments.filter((_, i) => i % 2 === 0), experiments.filter((_, i) => i % 2 === 1)];
const counts = Object.fromEntries(areas.map((a) => [a, experiments.filter((e) => e.area === a).length]));
---

<section class="exp section" id="experiments" aria-labelledby="exp-title" data-exp>
  <div class="wrap">
    <header class="section-head">
      <p class="micro"><span class="accent">(06)</span> Experiments</p>
      <p class="micro">{experiments.length} things on the bench</p>
    </header>
    <div class="exp__intro">
      <h2 id="exp-title" class="exp__title" data-split="words">Things I’m <span class="serif">building.</span></h2>
      <p class="lede" data-reveal>
        A lab notebook, not a showcase. Some of these ship, some become parts of other things, some teach me why they
        shouldn’t exist. All of them are real and most of them run on my laptop.
      </p>
    </div>
    <div class="exp__filters" role="group" aria-label="Filter experiments by area">
      <button type="button" class="exp__chip" aria-pressed="true" data-area="all">All <span>{experiments.length}</span></button>
      {areas.map((a) => (
        <button type="button" class="exp__chip" aria-pressed="false" data-area={a}>{a} <span>{counts[a]}</span></button>
      ))}
      <button type="button" class="exp__pause micro" aria-pressed="false" data-pause>Pause motion</button>
    </div>
  </div>

  <div class="exp__rows">
    {rows.map((row, r) => (
      <div class={`exp__row exp__row--${r}`} data-row>
        {[0, 1].map((copy) => (
          <ul class="exp__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {row.map((e) => {
              const Tag = e.href ? 'a' : 'div';
              return (
              <li class="tile" data-area={e.area} data-status={e.status}>
                <Tag class="tile__in" href={e.href ? url(e.href) : undefined} tabindex={copy === 1 && e.href ? -1 : undefined} data-cursor={e.href ? 'view' : undefined}>
                  <div class={`tile__glyph g-${e.glyph}`} aria-hidden="true">
                    {e.video ? (
                      <video muted loop playsinline preload="none" poster={url(`media/${e.video}.webp`)} data-hover-play>
                        <source src={url(`media/${e.video}.mp4`)} type="video/mp4" />
                      </video>
                    ) : (
                      <span class="gl"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                    )}
                  </div>
                  <div class="tile__body">
                    <p class="tile__meta"><span class={`tag tag--${e.status.replace(' ', '-').toLowerCase()}`}>{e.status}</span><span class="micro">{e.area}</span></p>
                    <h3 class="tile__name">{e.name}</h3>
                    <p class="tile__line">{e.line}</p>
                  </div>
                </Tag>
              </li>
              );
            })}
          </ul>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .exp { overflow: clip; }
  .exp__intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 5vw, 90px); align-items: end; margin-bottom: 36px; }
  .exp__title { font-size: var(--t-display); line-height: 0.88; letter-spacing: -0.058em; }
  .exp__title .serif { color: var(--accent); }
  .exp__filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(40px, 5vw, 64px); align-items: center; }
  .exp__chip { height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line-2); font-size: 0.8125rem; color: var(--fg-2); transition: all 0.3s; }
  .exp__chip span { font: 500 0.625rem/1 var(--mono); color: var(--fg-3); margin-left: 4px; }
  .exp__chip:hover { color: var(--fg); border-color: var(--line-3); }
  .exp__chip[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .exp__chip[aria-pressed='true'] span { color: var(--bg); opacity: 0.6; }
  .exp__pause { margin-left: auto; height: 34px; padding: 0 14px; border-radius: 999px; color: var(--fg-2); }
  .exp__pause:hover { color: var(--fg); }

  .exp__rows { display: grid; gap: 14px; }
  .exp__row { display: flex; width: max-content; }
  .exp__track { display: flex; gap: 14px; padding-right: 14px; animation: marquee var(--dur, 90s) linear infinite; }
  .exp__row--1 .exp__track { animation-direction: reverse; --dur: 110s; }
  .exp__row:hover .exp__track, .exp__row:focus-within .exp__track, .exp.is-paused .exp__track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-100%); } }

  .tile { flex: none; width: clamp(280px, 26vw, 380px); transition: opacity 0.5s, filter 0.5s; }
  .tile.is-dim { opacity: 0.18; filter: saturate(0); }
  .tile__in {
    display: grid; grid-template-rows: 150px auto; height: 100%;
    border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
    background: var(--bg-2);
    transition: border-color 0.4s, transform 0.6s var(--ease-out);
  }
  .tile__in:hover, .tile__in:focus-visible { border-color: var(--line-3); transform: translateY(-4px); }
  .tile__body { padding: 16px 18px 20px; }
  .tile__meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .tile__meta .micro { font-size: 0.5625rem; color: var(--fg-3); }
  .tile__name { font-size: 1.35rem; letter-spacing: -0.03em; line-height: 1.1; }
  .tile__line { margin-top: 8px; color: var(--fg-2); font-size: 0.875rem; line-height: 1.5; }
  .tag { font: 600 0.5625rem/1 var(--mono); letter-spacing: 0.12em; padding: 5px 7px; border-radius: 4px; border: 1px solid var(--line-2); color: var(--fg-2); }
  .tag--experiment { color: var(--accent); border-color: rgb(255 91 34 / 0.45); }
  .tag--prototype { color: #e8d9b0; border-color: rgb(232 217 176 / 0.35); }
  .tag--open-source { color: #b9e3c6; border-color: rgb(185 227 198 / 0.35); }
  .tag--in-progress { color: var(--fg); border-style: dashed; }
  .tag--shipped { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  /* ——— generative glyphs ——— */
  .tile__glyph { position: relative; overflow: hidden; background: radial-gradient(120% 100% at 50% 100%, #1a1714, #0e0e10); border-bottom: 1px solid var(--line); }
  .tile__glyph video { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .gl { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 6px; }
  .gl i { display: block; }
  .g-wave .gl i, .g-bars .gl i { width: 5px; border-radius: 3px; background: var(--fg); height: 20%; animation: eqb 1.3s ease-in-out infinite; }
  .g-wave .gl i:nth-child(odd) { background: var(--accent); }
  .g-bars .gl i { width: 16px; border-radius: 2px; background: var(--line-3); }
  .g-bars .gl i:nth-child(3n) { background: var(--accent); }
  .gl i:nth-child(1) { animation-delay: -0.1s; } .gl i:nth-child(2) { animation-delay: -0.5s; } .gl i:nth-child(3) { animation-delay: -0.9s; }
  .gl i:nth-child(4) { animation-delay: -0.3s; } .gl i:nth-child(5) { animation-delay: -1.1s; } .gl i:nth-child(6) { animation-delay: -0.7s; }
  .gl i:nth-child(7) { animation-delay: -0.2s; } .gl i:nth-child(8) { animation-delay: -0.8s; } .gl i:nth-child(9) { animation-delay: -0.4s; }
  @keyframes eqb { 50% { height: 70%; } }
  .g-grid .gl, .g-cells .gl { display: grid; grid-template-columns: repeat(3, 26px); gap: 6px; place-content: center; }
  .g-grid .gl i, .g-cells .gl i { height: 26px; border: 1px solid var(--line-3); border-radius: 4px; animation: cell 3s ease-in-out infinite; }
  .g-cells .gl i { border-radius: 50%; }
  @keyframes cell { 0%, 100% { background: transparent; } 40% { background: var(--accent); border-color: var(--accent); } 60% { background: transparent; } }
  .g-orbit .gl i, .g-rings .gl i { position: absolute; left: 50%; top: 50%; border-radius: 50%; border: 1px solid var(--line-2); }
  .g-orbit .gl i:nth-child(n) { width: calc(var(--s, 1) * 30px); height: calc(var(--s, 1) * 30px); margin: calc(var(--s, 1) * -15px); animation: spin calc(var(--s, 1) * 3s) linear infinite; border-top-color: var(--accent); }
  .g-orbit .gl i:nth-child(2) { --s: 2; } .g-orbit .gl i:nth-child(3) { --s: 3; } .g-orbit .gl i:nth-child(4) { --s: 4; } .g-orbit .gl i:nth-child(n + 5) { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .g-rings .gl i { width: 20px; height: 20px; margin: -10px; animation: ringp 3s ease-out infinite; }
  .g-rings .gl i:nth-child(2) { animation-delay: -1s; } .g-rings .gl i:nth-child(3) { animation-delay: -2s; } .g-rings .gl i:nth-child(n + 4) { display: none; }
  @keyframes ringp { from { transform: scale(1); opacity: 1; border-color: var(--accent); } to { transform: scale(7); opacity: 0; } }
  .g-nodes .gl i { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--fg-2); box-shadow: 0 0 0 4px rgb(236 232 225 / 0.06); animation: nodep 2.4s ease-in-out infinite; }
  .g-nodes .gl i:nth-child(1) { left: 20%; top: 30%; } .g-nodes .gl i:nth-child(2) { left: 45%; top: 60%; background: var(--accent); } .g-nodes .gl i:nth-child(3) { left: 70%; top: 25%; }
  .g-nodes .gl i:nth-child(4) { left: 80%; top: 70%; } .g-nodes .gl i:nth-child(5) { left: 30%; top: 75%; } .g-nodes .gl i:nth-child(n + 6) { display: none; }
  .g-nodes .gl::before { content: ''; position: absolute; inset: 0; background: linear-gradient(35deg, transparent 49.6%, var(--line-2) 50%, transparent 50.4%), linear-gradient(-20deg, transparent 49.6%, var(--line-2) 50%, transparent 50.4%); }
  @keyframes nodep { 50% { transform: scale(1.5); } }
  .g-face .gl { }
  .g-face .gl i { position: absolute; border: 1px solid var(--line-3); }
  .g-face .gl i:nth-child(1) { width: 70px; height: 90px; border-radius: 50% 50% 46% 46%; left: calc(50% - 35px); top: calc(50% - 45px); }
  .g-face .gl i:nth-child(2) { width: 30px; height: 10px; border-radius: 0 0 20px 20px; left: calc(50% - 15px); top: calc(50% + 14px); border-color: var(--accent); animation: talk 0.4s ease-in-out infinite alternate; }
  .g-face .gl i:nth-child(3) { width: 90px; height: 1px; left: calc(50% - 45px); top: 50%; border: 0; background: var(--accent); opacity: 0.6; animation: scanl 2.4s ease-in-out infinite; }
  .g-face .gl i:nth-child(n + 4) { display: none; }
  @keyframes talk { to { height: 3px; } }
  @keyframes scanl { 0%, 100% { transform: translateY(-40px); } 50% { transform: translateY(40px); } }
  .g-scan .gl i { position: absolute; }
  .g-scan .gl i:nth-child(1) { width: 110px; height: 70px; border: 1px solid var(--line-3); left: calc(50% - 55px); top: calc(50% - 35px); }
  .g-scan .gl i:nth-child(2) { width: 40px; height: 70px; border: 1.5px solid var(--accent); top: calc(50% - 35px); left: calc(50% - 20px); animation: pan 3s ease-in-out infinite alternate; }
  .g-scan .gl i:nth-child(n + 3) { display: none; }
  @keyframes pan { from { transform: translateX(-30px); } to { transform: translateX(30px); } }
  .g-type .gl { flex-direction: column; align-items: flex-start; padding: 0 28%; gap: 7px; }
  .g-type .gl i { height: 5px; border-radius: 3px; background: var(--line-3); width: 100%; transform-origin: 0 50%; animation: typel 3.2s steps(12) infinite; }
  .g-type .gl i:nth-child(2) { width: 80%; animation-delay: 0.3s; } .g-type .gl i:nth-child(3) { width: 90%; background: var(--accent); animation-delay: 0.6s; } .g-type .gl i:nth-child(n + 4) { display: none; }
  @keyframes typel { from { transform: scaleX(0); } 60%, to { transform: scaleX(1); } }

  @media (max-width: 860px) {
    .exp__intro { grid-template-columns: 1fr; }
    .exp__filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad); }
    .exp__pause { margin-left: 0; }
    .tile { width: 78vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp__rows { overflow-x: auto; }
    .exp__track[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-exp]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-area]')].filter((b) => b.tagName === 'BUTTON');
    const tiles = [...root.querySelectorAll<HTMLElement>('.tile')];
    chips.forEach((c) => c.addEventListener('click', () => {
      const a = c.dataset.area!;
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      tiles.forEach((t) => t.classList.toggle('is-dim', a !== 'all' && t.dataset.area !== a));
    }));
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    pause.addEventListener('click', () => {
      const on = !root.classList.contains('is-paused');
      root.classList.toggle('is-paused', on);
      pause.setAttribute('aria-pressed', String(on));
      pause.textContent = on ? 'Resume motion' : 'Pause motion';
    });
    root.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((v) => {
      const tile = v.closest('.tile__in')!;
      tile.addEventListener('pointerenter', () => { v.preload = 'auto'; v.play().catch(() => {}); });
      tile.addEventListener('pointerleave', () => v.pause());
    });
  });
</script>
