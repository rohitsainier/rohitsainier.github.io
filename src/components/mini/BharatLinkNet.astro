---
const nodes = [
  { id: 'a', x: 120, y: 236, name: 'rohit-mbp', os: 'macOS' },
  { id: 'b', x: 318, y: 118, name: 'alice-macbook', os: 'macOS' },
  { id: 'd', x: 318, y: 318, name: 'lab-desktop', os: 'Windows' },
  { id: 'c', x: 520, y: 236, name: 'ubuntu-box', os: 'Linux' },
];
---

<div class="bl" data-mini="bharatlink">
  <svg class="bl__svg" viewBox="0 0 640 400" aria-hidden="true">
    <rect class="bl__lan" x="40" y="70" width="380" height="300" rx="18" />
    <text class="bl__zone" x="58" y="92">LAN · mDNS · 192.168.1.0/24</text>
    <text class="bl__zone" x="470" y="160">other network · behind NAT</text>
    <g class="bl__relay" data-relay>
      <rect x="440" y="22" width="150" height="44" rx="10" />
      <text x="515" y="41">QUIC relay</text>
      <text class="bl__sub" x="515" y="56">helps peers meet · sees nothing</text>
    </g>
    <path class="bl__hole" data-hole d="M 120 236 C 260 40, 480 40, 515 66 M 515 66 C 520 120, 520 180, 520 236" />
    <line class="bl__link" data-link="ab" x1="120" y1="236" x2="318" y2="118" />
    <line class="bl__link" data-link="ad" x1="120" y1="236" x2="318" y2="318" />
    <line class="bl__link bl__link--wan" data-link="ac" x1="120" y1="236" x2="520" y2="236" />
    <g data-ripples></g>
    <g data-packets></g>
    {nodes.map((n) => (
      <g class="bl__node" data-node={n.id} transform={`translate(${n.x} ${n.y})`}>
        <circle r="30" class="bl__halo" />
        <rect x="-19" y="-13" width="38" height="24" rx="3" class="bl__dev" />
        <rect x="-24" y="12" width="48" height="4" rx="2" class="bl__dev bl__dev--base" />
        <text y="40" class="bl__name">{n.name}</text>
        <text y="53" class="bl__os">{n.os}</text>
      </g>
    ))}
    <g class="bl__tag" data-tag transform="translate(219 160)"><rect x="-58" y="-11" width="116" height="20" rx="10" /><text y="3">QUIC · TLS 1.3</text></g>
  </svg>
  <div class="bl__term">
    <p><span class="bl__pr">bharatlink&gt;</span> <span data-cmd></span><span class="bl__caret"></span></p>
    <p class="bl__line" data-line></p>
    <div class="bl__prog"><i data-prog></i></div>
  </div>
</div>

<style>
  .bl { position: relative; width: 100%; height: 100%; display: grid; grid-template-rows: 1fr auto; background: radial-gradient(90% 90% at 40% 45%, #0e1718, #07090a); color: #cfe9ee; font-family: var(--mono); }
  .bl__svg { width: 100%; height: 100%; min-height: 0; }
  .bl__lan { fill: rgb(34 211 238 / 0.03); stroke: rgb(34 211 238 / 0.25); stroke-dasharray: 4 6; }
  .bl__zone { font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; fill: rgb(207 233 238 / 0.45); }
  .bl__relay rect { fill: rgb(255 255 255 / 0.03); stroke: rgb(255 255 255 / 0.25); stroke-dasharray: 3 4; }
  .bl__relay text { font-size: 11px; fill: #cfe9ee; text-anchor: middle; }
  .bl__relay .bl__sub { font-size: 8px; fill: rgb(207 233 238 / 0.5); }
  .bl__hole { fill: none; stroke: rgb(255 255 255 / 0.35); stroke-width: 1; stroke-dasharray: 3 5; opacity: 0; }
  .bl__link { stroke: #22d3ee; stroke-width: 1.6; stroke-linecap: round; opacity: 0.9; }
  .bl__link--wan { stroke: #22d3ee; }
  .bl__node .bl__halo { fill: rgb(34 211 238 / 0.06); stroke: rgb(34 211 238 / 0.2); transition: fill 0.5s, stroke 0.5s; }
  .bl__node.is-on .bl__halo { fill: rgb(34 211 238 / 0.16); stroke: #22d3ee; }
  .bl__dev { fill: #0b1214; stroke: #cfe9ee; stroke-width: 1.2; }
  .bl__dev--base { fill: #cfe9ee; stroke: none; }
  .bl__name { font-size: 11px; fill: #eafcff; text-anchor: middle; }
  .bl__os { font-size: 8.5px; letter-spacing: 0.1em; text-transform: uppercase; fill: rgb(207 233 238 / 0.45); text-anchor: middle; }
  .bl__tag rect { fill: #07090a; stroke: #22d3ee; }
  .bl__tag text { font-size: 9px; letter-spacing: 0.1em; fill: #22d3ee; text-anchor: middle; }
  .bl :global(.ripple) { fill: none; stroke: #22d3ee; stroke-width: 1; }
  .bl :global(.pkt) { fill: #22d3ee; }
  .bl__term { padding: 12px 16px 14px; border-top: 1px solid rgb(34 211 238 / 0.15); font-size: 12px; line-height: 1.6; background: rgb(0 0 0 / 0.35); }
  .bl__term p { margin: 0; min-height: 1.6em; white-space: nowrap; overflow: hidden; }
  .bl__pr { color: #22d3ee; font-weight: 600; }
  .bl__line { color: rgb(207 233 238 / 0.7); }
  .bl__caret { display: inline-block; width: 7px; height: 13px; vertical-align: -2px; background: #22d3ee; animation: blc 1s steps(2) infinite; }
  @keyframes blc { 50% { opacity: 0; } }
  .bl__prog { height: 3px; margin-top: 6px; background: rgb(34 211 238 / 0.12); border-radius: 2px; overflow: hidden; }
  .bl__prog i { display: block; height: 100%; width: 100%; background: #22d3ee; transform-origin: 0 50%; transform: scaleX(0); }
</style>

<script>
  import { gsap } from '../../scripts/core';
  import { mini, loop, sleep, type } from '../../scripts/mini';

  document.querySelectorAll<HTMLElement>('[data-mini="bharatlink"]').forEach((root) => {
    const q = <T extends Element = SVGElement>(s: string) => root.querySelector<T>(s)!;
    const NS = 'http://www.w3.org/2000/svg';
    const pos: Record<string, [number, number]> = { a: [120, 236], b: [318, 118], d: [318, 318], c: [520, 236] };
    const links = ['ab', 'ad', 'ac'].map((k) => q<SVGLineElement>(`[data-link="${k}"]`));
    const nodes = [...root.querySelectorAll<SVGGElement>('[data-node]')];
    const ripples = q<SVGGElement>('[data-ripples]');
    const packets = q<SVGGElement>('[data-packets]');
    const hole = q<SVGPathElement>('[data-hole]');
    const relay = q<SVGGElement>('[data-relay]');
    const tag = q<SVGGElement>('[data-tag]');
    const cmd = q<HTMLElement>('[data-cmd]');
    const lineEl = q<HTMLElement>('[data-line]');
    const prog = q<HTMLElement>('[data-prog]');
    const len = (l: SVGLineElement) => Math.hypot(+l.getAttribute('x2')! - +l.getAttribute('x1')!, +l.getAttribute('y2')! - +l.getAttribute('y1')!);
    let tweens: gsap.core.Animation[] = [];

    const reset = () => {
      tweens.forEach((t) => t.kill()); tweens = [];
      links.forEach((l) => gsap.set(l, { strokeDasharray: len(l), strokeDashoffset: len(l) }));
      nodes.forEach((n) => n.classList.remove('is-on'));
      ripples.innerHTML = ''; packets.innerHTML = '';
      gsap.set([hole, tag], { opacity: 0 }); gsap.set(relay, { opacity: 0.35 });
      cmd.textContent = ''; lineEl.textContent = ''; gsap.set(prog, { scaleX: 0 });
    };
    const on = (id: string) => nodes.find((n) => n.dataset.node === id)?.classList.add('is-on');
    const ripple = (id: string) => {
      const [x, y] = pos[id];
      for (let i = 0; i < 3; i++) {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('class', 'ripple'); c.setAttribute('cx', String(x)); c.setAttribute('cy', String(y)); c.setAttribute('r', '28');
        ripples.appendChild(c);
        tweens.push(gsap.fromTo(c, { attr: { r: 28 }, opacity: 0.8 }, { attr: { r: 230 }, opacity: 0, duration: 2.2, delay: i * 0.45, ease: 'power2.out', onComplete: () => c.remove() }));
      }
    };
    const stream = (from: string, to: string, n = 14) => {
      const [x1, y1] = pos[from], [x2, y2] = pos[to];
      for (let i = 0; i < n; i++) {
        const r = document.createElementNS(NS, 'rect');
        r.setAttribute('class', 'pkt'); r.setAttribute('width', '7'); r.setAttribute('height', '5'); r.setAttribute('rx', '1.5');
        packets.appendChild(r);
        tweens.push(gsap.fromTo(r, { x: x1 - 3.5, y: y1 - 2.5, opacity: 0 }, { x: x2 - 3.5, y: y2 - 2.5, opacity: 1, duration: 1.1, ease: 'none', delay: i * 0.16, repeat: -1, repeatDelay: n * 0.16 - 1.1 }));
      }
    };
    const draw = (l: SVGLineElement, d = 0.9) => new Promise<void>((res) => tweens.push(gsap.to(l, { strokeDashoffset: 0, duration: d, ease: 'power2.inOut', onComplete: res })));

    const L = loop(async (alive) => {
      reset();
      on('a');
      await type(cmd, 'start', alive, 40);
      lineEl.textContent = 'Node a1b2c3d4… listening · discovering peers (mDNS)';
      ripple('a'); await sleep(900); if (!alive()) return;
      on('b'); await sleep(250); on('d');
      lineEl.textContent = '✔ found alice-macbook, lab-desktop · 0.4 s';
      await sleep(900); if (!alive()) return;
      cmd.textContent = '';
      await type(cmd, 'send file k7x9 ./project.zip', alive, 34);
      lineEl.textContent = 'Connecting to alice-macbook…';
      await draw(links[0]); if (!alive()) return;
      tweens.push(gsap.to(tag, { opacity: 1, duration: 0.4 }));
      lineEl.textContent = '✔ Connected (QUIC, encrypted) · sending project.zip (24.8 MB)';
      stream('a', 'b');
      await new Promise<void>((res) => tweens.push(gsap.to(prog, { scaleX: 1, duration: 2.6, ease: 'none', onComplete: res })));
      if (!alive()) return;
      lineEl.textContent = '✔ 24.8 MB at 15.7 MB/s · every chunk verified (BLAKE3)';
      await sleep(1300); if (!alive()) return;
      packets.innerHTML = ''; gsap.set(prog, { scaleX: 0 }); tweens.push(gsap.to(tag, { opacity: 0, duration: 0.3 }));
      cmd.textContent = '';
      await type(cmd, 'send text 9e4f "deploy done"', alive, 30);
      lineEl.textContent = 'Peer is behind NAT · asking relay for a hole punch…';
      tweens.push(gsap.to(relay, { opacity: 1, duration: 0.4 }), gsap.fromTo(hole, { opacity: 0 }, { opacity: 1, duration: 0.5 }));
      await sleep(1300); if (!alive()) return;
      on('c');
      await draw(links[2], 0.8); if (!alive()) return;
      tweens.push(gsap.to(hole, { opacity: 0, duration: 0.6 }), gsap.to(relay, { opacity: 0.35, duration: 0.6 }));
      lineEl.textContent = '✔ Direct path open · relay stepped aside · delivered';
      stream('a', 'c', 6);
      await sleep(2400);
    });

    mini(root, {
      start: L.start,
      stop: () => { L.stop(); tweens.forEach((t) => t.kill()); },
      still: () => {
        links.forEach((l) => gsap.set(l, { strokeDasharray: 'none' }));
        nodes.forEach((n) => n.classList.add('is-on'));
        cmd.textContent = 'send file k7x9 ./project.zip';
        lineEl.textContent = '✔ Connected (QUIC, encrypted) · 24.8 MB at 15.7 MB/s';
        gsap.set(prog, { scaleX: 1 });
      },
    });
  });
</script>
