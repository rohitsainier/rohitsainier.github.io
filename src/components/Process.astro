---
const stages = [
  { w: 'Idea', s: 'Ideas are cheap.', d: 'I write them down, then wait to see which ones keep coming back.' },
  { w: 'Prototype', s: 'So I build one the same day.', d: 'Ugly, fast, real. A prototype is a question you can hold.' },
  { w: 'Experiment', s: 'Experiments reveal what matters.', d: 'Measure it, show it to someone, watch where they hesitate.' },
  { w: 'Break', s: 'Then I try to break it.', d: 'Edge cases, bad input, slow networks, a model having a bad day.' },
  { w: 'Iterate', s: 'Code turns experiments into products.', d: 'Keep what survived. Delete what didn’t. Loop.' },
  { w: 'Ship', s: 'Shipping makes them real.', d: 'App Store, crates.io, Chrome Web Store, a live newsroom. Done is a feature.' },
];
---

<section class="proc" id="process" aria-labelledby="proc-title" data-proc>
  <div class="proc__pin" data-proc-pin>
    <div class="wrap proc__grid">
      <header class="proc__head">
        <p class="micro"><span class="accent">(07)</span> How I build</p>
        <h2 id="proc-title" class="sr-only">How I build: idea, prototype, experiment, break, iterate, ship</h2>
        <p class="proc__count micro" aria-hidden="true"><span data-proc-n>01</span> / 06</p>
      </header>

      <ol class="proc__words" aria-hidden="true">
        {stages.map((st, i) => (
          <li class={`pw pw--${st.w.toLowerCase()}`} data-pw={i}>
            <span class="pw__i">0{i + 1}</span>
            <span class="pw__w" data-text={st.w}>{st.w}</span>
          </li>
        ))}
      </ol>

      <svg class="proc__line" viewBox="0 0 40 600" preserveAspectRatio="none" aria-hidden="true">
        <path class="proc__track" d="M 20 0 V 600" />
        <path class="proc__fill" d="M 20 0 V 600" data-proc-fill />
        <path class="proc__loop" d="M 22 470 C 44 470, 44 250, 22 250" data-proc-loop />
      </svg>

      <ol class="proc__says">
        {stages.map((st, i) => (
          <li class="ps" data-ps={i} data-word={st.w}>
            <p class="ps__s">{st.s}</p>
            <p class="ps__d">{st.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .proc { position: relative; border-top: 1px solid var(--line); }
  .proc__pin { min-height: 100svh; display: flex; align-items: center; padding-block: calc(var(--nav-h) + 4vh) 6vh; }
  .proc__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) 40px minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: clamp(20px, 4vw, 64px); row-gap: 4vh; width: 100%; }
  .proc__head { grid-column: 1 / -1; display: flex; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .proc__words { display: grid; align-content: center; }
  .pw { display: flex; align-items: baseline; gap: 16px; line-height: 0.9; }
  .pw__i { font: 500 0.6875rem/1 var(--mono); color: var(--fg-3); width: 22px; transition: color 0.4s; }
  .pw__w {
    position: relative;
    font-size: clamp(2.6rem, 8.4vh, 7.4rem); letter-spacing: -0.055em; font-weight: 500; text-transform: uppercase;
    color: rgb(236 232 225 / 0.12);
    transition: color 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .pw.is-on .pw__w { color: var(--fg); transform: translateX(14px); }
  .pw.is-on .pw__i { color: var(--accent); }
  .pw.is-past .pw__w { color: rgb(236 232 225 / 0.3); }
  /* BREAK glitches when active */
  .pw--break.is-on .pw__w::before, .pw--break.is-on .pw__w::after {
    content: attr(data-text); position: absolute; left: 0; top: 0; width: 100%;
    color: var(--accent); mix-blend-mode: screen;
  }
  .pw--break.is-on .pw__w::before { animation: glitchA 1.1s steps(2) infinite; clip-path: inset(0 0 60% 0); }
  .pw--break.is-on .pw__w::after { color: var(--fg-2); animation: glitchB 0.9s steps(2) infinite; clip-path: inset(55% 0 0 0); }
  @keyframes glitchA { 0% { transform: translate(-6px, -2px); } 25% { transform: translate(8px, 0); } 50% { transform: translate(-3px, 2px); } 75% { transform: translate(4px, -1px); } }
  @keyframes glitchB { 0% { transform: translate(5px, 1px); } 30% { transform: translate(-7px, 0); } 60% { transform: translate(3px, -2px); } }
  /* ITERATE rotates its index like a loop */
  .pw--iterate.is-on .pw__i { animation: spin 1.8s linear infinite; display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }
  /* SHIP gets the accent */
  .pw--ship.is-on .pw__w { color: var(--accent); }

  .proc__line { width: 40px; height: 100%; align-self: stretch; overflow: visible; }
  .proc__track { stroke: var(--line-2); stroke-width: 1; fill: none; vector-effect: non-scaling-stroke; }
  .proc__fill { stroke: var(--accent); stroke-width: 2; fill: none; vector-effect: non-scaling-stroke; }
  .proc__loop { stroke: var(--accent); stroke-width: 1.5; fill: none; stroke-dasharray: 4 5; vector-effect: non-scaling-stroke; opacity: 0; }

  .proc__says { display: grid; align-content: center; }
  .ps { grid-area: 1 / 1; max-width: 26ch; }
  .ps__s { font-size: clamp(2rem, 3.6vw, 3.8rem); line-height: 1; letter-spacing: -0.045em; }
  .ps__d { margin-top: 22px; color: var(--fg-2); max-width: 38ch; }
  html.motion .ps { opacity: 0; visibility: hidden; }
  html.motion .ps:first-child { opacity: 1; visibility: visible; }
  /* reduced motion / no JS: every statement, stacked and labelled */
  html:not(.motion) .proc__says { gap: 40px; }
  html:not(.motion) .ps { grid-area: auto; }
  html:not(.motion) .ps::before { content: attr(data-word); display: block; margin-bottom: 12px; font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

  @media (max-width: 860px) {
    .proc__pin { min-height: 0; padding-block: 100px 60px; }
    .proc__grid { grid-template-columns: 1fr; }
    .proc__line, .proc__count { display: none; }
    .proc__words { display: none; }
    .proc__says { gap: 36px; }
    .ps { grid-area: auto; }
    html.motion .ps { opacity: 1; visibility: visible; }
    .ps::before { content: attr(data-word); display: block; margin-bottom: 12px; font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../scripts/core';

  document.querySelectorAll<HTMLElement>('[data-proc]').forEach((root) => {
    const words = [...root.querySelectorAll<HTMLElement>('[data-pw]')];
    const says = [...root.querySelectorAll<HTMLElement>('[data-ps]')];
    const fill = root.querySelector<SVGPathElement>('[data-proc-fill]')!;
    const loopPath = root.querySelector<SVGPathElement>('[data-proc-loop]')!;
    const n = root.querySelector<HTMLElement>('[data-proc-n]')!;
    const N = words.length;
    let cur = -1;

    const set = (i: number) => {
      if (i === cur) return;
      const prev = cur; cur = i;
      words.forEach((w, j) => { w.classList.toggle('is-on', j === i); w.classList.toggle('is-past', j < i); });
      n.textContent = String(i + 1).padStart(2, '0');
      if (prev >= 0) gsap.to(says[prev], { autoAlpha: 0, y: i > prev ? -30 : 30, duration: 0.4, ease: 'power2.in' });
      gsap.fromTo(says[i], { autoAlpha: 0, y: i > prev ? 40 : -40 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'expo.out', delay: prev >= 0 ? 0.2 : 0 });
      gsap.to(loopPath, { opacity: i === 4 ? 1 : 0, duration: 0.5 });
    };

    const mm = gsap.matchMedia();
    mm.add('(min-width: 861px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.set(says, { autoAlpha: 0 });
      set(0);
      const st = ScrollTrigger.create({
        trigger: root,
        pin: root.querySelector('[data-proc-pin]'),
        start: 'top top',
        end: () => `+=${innerHeight * 2.4}`,
        onUpdate: (s) => {
          set(Math.min(N - 1, Math.floor(s.progress * N)));
          const L = fill.getBoundingClientRect().height || 600;
          fill.style.strokeDasharray = String(L);
          fill.style.strokeDashoffset = String(L * (1 - s.progress));
          loopPath.style.strokeDashoffset = String(-s.progress * 200);
        },
      });
      return () => st.kill();
    });
    mm.add('(max-width: 860px), (prefers-reduced-motion: reduce)', () => {
      gsap.set(says, { clearProps: 'all' });
    });
    if (reduceMotion) words.forEach((w) => w.classList.add('is-past'));
  });
</script>
