---
import type { Project } from '../data/projects';
import Video from './Video.astro';
import FluxTerminal from './FluxTerminal.astro';
import BharatLinkNet from './mini/BharatLinkNet.astro';
import QuickKitPanel from './mini/QuickKitPanel.astro';
import LinkedCommentFlow from './mini/LinkedCommentFlow.astro';
import MdMedium from './mini/MdMedium.astro';
import StyleSnapInspect from './mini/StyleSnapInspect.astro';
import wltp from '../data/wltp.json';

interface Props { project: Project; mode?: 'card' | 'hero' }
const { project: p, mode = 'card' } = Astro.props;

// battery hero figure: the real drive-cycle speed trace as a polyline
const kmh = wltp.kmh as number[];
const W = 1000, H = 300;
const pts = kmh.filter((_, i) => i % 2 === 0).map((v, i, a) => `${((i / (a.length - 1)) * W).toFixed(1)},${(H - 20 - (v / 140) * (H - 60)).toFixed(1)}`).join(' ');
---

<div class:list={['pv', `pv--${p.visual}`, `pv--${mode}`]}>
  {p.visual === 'dub' && (
    <div class="dubv">
      <figure class="dubv__side">
        <Video src="hero/en" label="Meera, a virtual anchor, presenting in English" />
        <figcaption><span class="micro">Source</span><span>English</span></figcaption>
      </figure>
      <span class="dubv__arrow" aria-hidden="true"><i></i>AI</span>
      <figure class="dubv__side dubv__side--hi">
        <Video src="hero/hi" label="Meera presenting the same script in Hindi" />
        <figcaption><span class="micro">AI</span><span lang="hi">हिन्दी</span></figcaption>
      </figure>
    </div>
  )}
  {p.visual === 'creatorcut' && (
    <div class="ccv">
      <Video src="work/creatorcut-dual" label="CreatorCut on iPhone showing the portrait and landscape previews side by side" />
      <div class="ccv__hud" aria-hidden="true">
        <span class="ccv__rec"><i></i>REC · one take</span>
        <div class="ccv__outs">
          <div class="ccv__out"><i class="ccv__ico ccv__ico--p"></i><span>reel.mp4</span><em>9:16 · 1080×1920</em><b><u></u></b></div>
          <div class="ccv__out"><i class="ccv__ico ccv__ico--l"></i><span>wide.mov</span><em>16:9 · 3840×2160</em><b><u></u></b></div>
        </div>
      </div>
    </div>
  )}
  {p.visual === 'flux' && <div class="fluxv"><FluxTerminal /></div>}
  {p.visual === 'battery' && (
    <figure class="batv">
      <figcaption class="micro"><span>Fig. 0 — WLTP-class drive cycle · 1,604 s</span><span>km/h</span></figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-label="Speed trace of the drive cycle used by the simulator" role="img">
        {[0, 50, 100].map((v) => <line x1="0" x2={W} y1={H - 20 - (v / 140) * (H - 60)} y2={H - 20 - (v / 140) * (H - 60)} class="batv__grid" />)}
        <polyline points={pts} class="batv__line" />
      </svg>
    </figure>
  )}
  {p.visual === 'bharatlink' && <div class="minv"><BharatLinkNet /></div>}
  {p.visual === 'quickkit' && <div class="minv"><QuickKitPanel /></div>}
  {p.visual === 'linkedcomment' && <div class="minv"><LinkedCommentFlow /></div>}
  {p.visual === 'mdtomedium' && <div class="minv"><MdMedium /></div>}
  {p.visual === 'stylesnap' && <div class="minv"><StyleSnapInspect /></div>}
</div>

<style>
  .pv { position: relative; width: 100%; height: 100%; }
  .minv { width: 100%; height: 100%; }
  .pv--hero .minv { aspect-ratio: 16 / 9.5; }

  /* dub */
  .dubv { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(10px, 1.6vw, 24px); padding: clamp(18px, 3vw, 44px); aspect-ratio: 16 / 11; background: radial-gradient(90% 80% at 50% 50%, #17130f, #0b0b0c); }
  .pv--hero .dubv { aspect-ratio: auto; height: clamp(420px, 74vh, 780px); }
  .dubv__side { position: relative; height: 100%; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
  .dubv__side :global(.vid) { flex: 1; min-height: 0; aspect-ratio: 2 / 3; width: auto; margin-inline: auto; border-radius: 12px; box-shadow: 0 0 0 1px var(--line-2); }
  .dubv__side--hi :global(.vid) { box-shadow: 0 0 0 1.5px var(--accent), 0 20px 60px -20px rgb(255 91 34 / 0.45); }
  .dubv__side figcaption { display: flex; justify-content: center; align-items: baseline; gap: 10px; }
  .dubv__side figcaption span:last-child { font-size: 1.05rem; }
  .dubv__side figcaption [lang='hi'] { font-family: var(--deva); }
  .dubv__side--hi figcaption .micro { color: var(--accent); }
  .dubv__arrow { display: grid; justify-items: center; gap: 8px; font: 600 0.625rem/1 var(--mono); letter-spacing: 0.14em; color: var(--accent); }
  .dubv__arrow i { width: clamp(30px, 4vw, 70px); height: 1px; background: linear-gradient(90deg, transparent, var(--accent)); position: relative; }
  .dubv__arrow i::after { content: ''; position: absolute; right: 0; top: -3px; border: 3.5px solid transparent; border-left: 6px solid var(--accent); border-right: 0; }

  /* creatorcut */
  .ccv { position: relative; aspect-ratio: 16 / 10; }
  .pv--hero .ccv { aspect-ratio: 16 / 9; }
  .ccv :global(.vid) { position: absolute; inset: 0; }
  .ccv__hud { position: absolute; inset: 0; pointer-events: none; }
  .ccv__rec {
    position: absolute; left: 18px; top: 18px;
    display: flex; align-items: center; gap: 8px;
    padding: 7px 11px; border-radius: 999px;
    background: rgb(0 0 0 / 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    font: 500 0.625rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: #fff;
  }
  .ccv__rec i { width: 7px; height: 7px; border-radius: 50%; background: #ff4d4d; animation: ccblink 1.4s steps(2) infinite; }
  @keyframes ccblink { 50% { opacity: 0.2; } }
  .ccv__outs {
    position: absolute; right: 18px; bottom: 18px; width: min(300px, 58%);
    display: grid; gap: 6px; padding: 10px; border-radius: 12px;
    background: rgb(10 10 11 / 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .ccv__out { display: grid; grid-template-columns: 22px 1fr auto; grid-template-rows: auto auto; column-gap: 10px; align-items: center; font-size: 0.75rem; color: #fff; }
  .ccv__out em { font: 450 0.5625rem/1 var(--mono); font-style: normal; letter-spacing: 0.06em; color: var(--fg-2); }
  .ccv__out b { grid-column: 2 / -1; height: 2px; margin-top: 6px; border-radius: 2px; background: rgb(255 255 255 / 0.1); overflow: hidden; }
  .ccv__out b u { display: block; height: 100%; width: 100%; transform-origin: 0 50%; animation: ccrender 6s var(--ease-io) infinite; }
  .ccv__out:first-child b u { background: #4fc8ff; }
  .ccv__out:last-child b u { background: #ffc74d; animation-delay: 0.25s; }
  @keyframes ccrender { 0%, 12% { transform: scaleX(0); } 70%, 100% { transform: scaleX(1); } }
  .ccv__ico { grid-row: 1 / 3; justify-self: center; border: 1.5px solid; border-radius: 3px; }
  .ccv__ico--p { width: 10px; height: 17px; color: #4fc8ff; }
  .ccv__ico--l { width: 18px; height: 11px; color: #ffc74d; }

  /* flux */
  .fluxv { aspect-ratio: 16 / 11.5; padding: clamp(14px, 2.4vw, 36px); background: radial-gradient(90% 90% at 50% 40%, #11131a, #0a0a0b); }
  .pv--hero .fluxv { aspect-ratio: 16 / 9; }

  /* battery */
  .batv { aspect-ratio: 16 / 7; padding: clamp(16px, 2.4vw, 32px); background: linear-gradient(rgb(236 232 225 / 0.05) 1px, transparent 1px) 0 0 / 100% 40px, linear-gradient(90deg, rgb(236 232 225 / 0.05) 1px, transparent 1px) 0 0 / 40px 100%, #0c0d0d; color: var(--fg); display: grid; grid-template-rows: auto 1fr; gap: 12px; }
  .batv figcaption { display: flex; justify-content: space-between; color: var(--fg-2); }
  .batv svg { width: 100%; height: 100%; }
  .batv__grid { stroke: rgb(236 232 225 / 0.1); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .batv__line { fill: none; stroke: var(--accent); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linejoin: round; }

  @media (max-width: 960px) {
    .dubv { aspect-ratio: 4 / 3.6; }
    .pv--hero .dubv { height: auto; aspect-ratio: 4 / 3.8; }
    .fluxv { aspect-ratio: 4 / 4.2; }
    .pv--hero .minv { aspect-ratio: 4 / 4.4; }
    .batv { aspect-ratio: 4 / 3; }
  }
</style>
